# Optional raster override. Copy to .env.local before building.
# Leave the URL empty for the default OpenFreeMap Liberty vector street map.
# Map resources are requested from tiles.openfreemap.org; no API key required.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_MAX_ZOOM=19

# To override the default, use an HTTPS XYZ URL with {z}, {x} and {y}, e.g.
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# Required for a custom provider: plain-text credit displayed alongside the
# OpenStreetMap attribution. Follow the provider's terms and zoom limits.
VITE_MAP_TILE_ATTRIBUTION=

# OpenFreeMap rebuilds its OSM-derived basemap weekly. This does not refresh
# the planner's saved venues, hours, prices, paths or access information.
# Google Maps listing/navigation links require no API key.
# VITE_* values are public in the build. Never put secret tokens here.
