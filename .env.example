# Optional map provider configuration. Copy to .env.local before building.
# The default OpenStreetMap community server is best effort with limited capacity.
# See https://operations.osmfoundation.org/policies/tiles/ before public hosting.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_MAX_ZOOM=19

# Required for a custom provider: plain text credit displayed alongside the
# OpenStreetMap attribution. Follow your provider's terms and zoom limits.
VITE_MAP_TILE_ATTRIBUTION=

# VITE_* values are included in the public bundle. Never put secret tokens here.
